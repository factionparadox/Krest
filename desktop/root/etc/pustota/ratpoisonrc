# Pustota's ratpoison settings (your ~/.ratpoisonrc sources this file).
# ratpoison gives each window the whole screen; split the screen into frames to see several.
# Two ways to give commands:
#   Super + a key       the everyday shortcuts below, no prefix
#   Ctrl+t, then a key  ratpoison's own keys (Ctrl+t ? lists them all)

startup_message off
escape C-t
set font "DejaVu Sans Mono-11"
set fgcolor #d8d8d8
set bgcolor #16161c
set fwcolor #c8323c
set bwcolor #2a2a32
set border 2
set barpadding 8 4
set inputwidth 640
set msgwait 3
set padding 0 30 0 0
set winname class
set winliststyle column
set transgravity center
set maxsizegravity center
set waitcursor 1

# programs
definekey top s-Return exec xterm
definekey top s-d exec dmenu_run -i -fn 'DejaVu Sans Mono-12' -nb '#16161c' -sb '#c8323c'
definekey top s-space exec pustota-menu
definekey top s-w exec firefox
definekey top s-e exec xterm -title Files -e mc
definekey top s-a exec pustota-acme
definekey top s-r exec pustota-menu russian
definekey top s-n exec networkmanager_dmenu
definekey top s-b exec xterm -title Bluetooth -e bluetuith
definekey top s-m exec xterm -title Sound -e pulsemixer
definekey top s-p exec pustota-menu power
definekey top s-l exec loginctl lock-session
definekey top s-question exec pustota-keys
definekey top s-slash exec pustota-keys
definekey top Print exec pustota-screenshot
definekey top S-Print exec pustota-screenshot area

# windows and frames
definekey top s-Tab next
definekey top s-ISO_Left_Tab prev
definekey top s-grave windows
definekey top s-q delete
definekey top s-s vsplit
definekey top s-S-s hsplit
definekey top s-x remove
definekey top s-o only
definekey top s-f only
definekey top s-Left focusleft
definekey top s-Right focusright
definekey top s-Up focusup
definekey top s-Down focusdown
definekey top s-S-Left exchangeleft
definekey top s-S-Right exchangeright
definekey top s-S-Up exchangeup
definekey top s-S-Down exchangedown
definekey top s-0 select 0
definekey top s-1 select 1
definekey top s-2 select 2
definekey top s-3 select 3
definekey top s-4 select 4
definekey top s-5 select 5
definekey top s-6 select 6
definekey top s-7 select 7
definekey top s-8 select 8
definekey top s-9 select 9
definekey top s-S-r source /etc/pustota/ratpoisonrc

# the laptop's own keys
definekey top XF86AudioRaiseVolume exec pamixer -i 5
definekey top XF86AudioLowerVolume exec pamixer -d 5
definekey top XF86AudioMute exec pamixer -t
definekey top XF86AudioMicMute exec pamixer --default-source -t
definekey top XF86MonBrightnessUp exec brightnessctl -q set +5%
definekey top XF86MonBrightnessDown exec brightnessctl -q set 5%-
