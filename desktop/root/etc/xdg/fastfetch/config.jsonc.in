// Rassvet's fastfetch (copy to ~/.config/fastfetch/config.jsonc to change yours).
// The logo is the Рассвет sunrise mark (build/make-branding.py), drawn in true colour:
// the Russian flag's white, blue and red, two pixels per character ("file-raw": printed as is).
// The image itself: fastfetch --logo /usr/share/rassvet/rassvet-logo.png --logo-type sixel
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/rassvet/fastfetch-logo.txt",
    "width": 44,
    "height": 22,
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "white" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "Distro", "format": "Рассвет / Rassvet @VERSION@ (Guix System)" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
