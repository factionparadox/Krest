// Pustota's fastfetch (copy to ~/.config/fastfetch/config.jsonc to change yours).
// The logo is the hand-drawn ASCII Пустота roundel (branding/pustota-ascii.txt), in the 256-colour
// palette: 1 blue, 2 and 3 reds, 4 white, 5 dark grey and 6 light grey for the letters.
// Other versions:
//   fastfetch --logo /usr/share/pustota/fastfetch-logo-blocks.txt --logo-type file-raw   (true-colour blocks)
//   fastfetch --logo /usr/share/pustota/pustota-logo.png --logo-type sixel               (the image)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/pustota/fastfetch-logo.txt",
    "color": {
      "1": "38;5;20",
      "2": "38;5;160",
      "3": "38;5;196",
      "4": "38;5;231",
      "5": "38;5;239",
      "6": "38;5;251"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "white" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "custom", "key": "Distro", "format": "Пустота / Pustota @VERSION@ (Void Linux)" },
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "battery",
    "locale",
    "break",
    "colors"
  ]
}
