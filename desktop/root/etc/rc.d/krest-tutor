#!/bin/sh
#
# /etc/rc.d/krest-tutor: the Russian tutor's language model (llama.cpp's llama-server),
# on 127.0.0.1 only, as nobody. It starts only once krest-content has downloaded the model.
#

SSD=/sbin/start-stop-daemon
PROG=/usr/bin/llama-server
MODEL=/var/lib/krest/russian/tutor/tutor.gguf
PID=/run/krest-tutor.pid
LOG=/var/log/krest-tutor.log

case $1 in
start)
	[ -f $MODEL ] || exit 0
	touch $LOG && chown nobody $LOG
	$SSD --start --background --make-pidfile --pidfile $PID --chuid nobody \
		--startas /bin/sh -- -c "exec $PROG --model $MODEL --alias qwen3.6-35b-a3b \
		--host 127.0.0.1 --port 11434 --jinja --ctx-size 16384 >> $LOG 2>&1"
	;;
stop)
	$SSD --stop --retry 10 --pidfile $PID --remove-pidfile
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --pidfile $PID && echo "running" || echo "not running"
	;;
*)
	echo "usage: $0 [start|stop|restart|status]"
	;;
esac

# End of file
