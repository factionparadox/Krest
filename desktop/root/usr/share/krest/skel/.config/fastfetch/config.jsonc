// fastfetch on Krest: Паша, the Krest penguin, with the four stars of the Southern Cross
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/krest/fastfetch/pasha.txt",
    "padding": { "right": 2 }
  },
  "display": { "color": { "keys": "red" }, "separator": "  " },
  "modules": [
    "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "wm", "terminal", "cpu", "gpu", "memory", "swap", "disk", "battery",
    "locale", "break", "colors"
  ]
}
