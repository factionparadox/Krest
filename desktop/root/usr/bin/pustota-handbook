#!/bin/sh
# The Void Linux Handbook, offline (package void-docs, in /usr/share/doc/void).
#   pustota-handbook        Midnight Commander: the Handbook on the left, the Pustota wiki on
#                           the right. Arrows and Enter to move, F3 reads a page (q closes it),
#                           Tab switches sides, F10 quits.
#   pustota-handbook pdf    the whole Handbook as a book, in zathura
#   pustota-handbook web    the Handbook's own web pages, in Firefox (with its search box)
docs=/usr/share/doc/void
[ -d "$docs" ] || { echo "The Handbook is missing: sudo xbps-install void-docs" >&2; exit 1; }
case "${1:-mc}" in
  mc)  exec pustota-term "Void Handbook" mc "$docs/markdown" /usr/share/pustota/learn/wiki ;;
  pdf) exec zathura "$docs/handbook.pdf" ;;
  web) exec firefox "file://$docs/html/index.html" ;;
  *)   echo "usage: pustota-handbook [mc|pdf|web]" >&2; exit 2 ;;
esac
