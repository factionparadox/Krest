#!/bin/sh
# Update everything, the CRUX way: fetch the newest ports (CRUX's collections and Rassvet's own,
# from this system's copy of the Rassvet repository), then rebuild whatever changed.
#   rassvet-update          ports -u, then prt-get sysup (every update, built here)
#   rassvet-update --dry    only show what would be rebuilt
# The kernel is a port too ("linux"); after it rebuilds, restart to use it.
set -e
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
echo "==> Rassvet's own ports (git pull in /usr/src/rassvet, checked and copied to /usr/ports/rassvet)"
git -C /usr/src/rassvet pull --ff-only
/usr/src/rassvet/build/rassvet-ports sync /usr/src/rassvet
echo
echo "==> CRUX's ports (ports -u)"
ports -u
echo
if [ "${1:-}" = --dry ]; then
	prt-get diff
	exit 0
fi
echo "==> Rebuilding what changed (prt-get sysup; each build shows here)"
prt-get sysup
echo
echo "Done. Anything new that was kept aside: sudo rejmerge"
