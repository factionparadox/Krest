#!/bin/sh
# The CRUX handbook, offline (it came with the install stick), beside the Krest wiki.
#   krest-handbook        the handbook in less (/ searches, q quits)
#   krest-handbook mc     Midnight Commander: the handbook and the Krest wiki side by side
book=/usr/share/doc/crux/handbook.txt
case "${1:-read}" in
	read) exec krest-term "CRUX handbook" less "$book" ;;
	mc)   exec krest-term "Handbook" mc /usr/share/krest/learn/wiki /usr/share/doc/crux ;;
	*)    echo "usage: krest-handbook [read|mc]" >&2; exit 2 ;;
esac
