#!/bin/sh
# Workstations 1-9 are ratpoison groups. ratpoison starts with one group, number 0; this adds
# 1-9 in order, so each one's number and name are the same, then goes to 1. Safe to run again.
have=$(ratpoison -c groups)
made=
for n in 1 2 3 4 5 6 7 8 9; do
  printf '%s\n' "$have" | grep -q "^$n[^0-9]" || { ratpoison -c "gnewbg $n"; made=1; }
done
[ -n "$made" ] && ratpoison -c "gselect 1"
polybar-msg action "#workstation.hook.0" >/dev/null 2>&1 || true
