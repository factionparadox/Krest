#!/bin/sh
# Night light (redshift): the screen warms after sunset and cools at sunrise.
#   rassvet-nightlight          start (the session does this)
#   rassvet-nightlight toggle   on/off
# Sunset is worked out from your timezone's city in /usr/share/zoneinfo/zone1970.tab, so no
# location service runs and nothing is sent anywhere.
case "${1:-start}" in
  toggle) pkill -USR1 -x redshift && exit 0 ;;
  stop)   exec pkill -x redshift ;;
esac
pgrep -u "$(id -u)" -x redshift >/dev/null && exit 0
zone=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
place=$(awk -F'\t' -v z="$zone" '
  function deg(s, n,   sign) { sign = substr(s, 1, 1) == "-" ? -1 : 1; s = substr(s, 2)
    return sign * (substr(s, 1, n) + substr(s, n + 1, 2) / 60 + substr(s, n + 3, 2) / 3600) }
  $3 == z { c = $2; i = match(substr(c, 2), /[+-]/) + 1
            printf "%.2f:%.2f", deg(substr(c, 1, i - 1), 2), deg(substr(c, i), 3); exit }
' /usr/share/zoneinfo/zone1970.tab 2>/dev/null)
exec redshift -P -m randr -l "${place:-51.51:-0.13}" -t 6500:3600
