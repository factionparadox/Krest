#!/bin/sh
# Super+r: this window's width, round 33% -> 50% -> 67% -> 100%. The rest of the screen shows
# the next window. (It goes back to one frame first, so it replaces any splits you made.)
state=${XDG_RUNTIME_DIR:-/tmp}/krest-width
case "$(cat "$state" 2>/dev/null)" in
  33) next=50 ;; 50) next=67 ;; 67) next=100 ;; *) next=33 ;;
esac
case $next in
  33)  ratpoison -c only -c "vsplit 1/3" ;;
  50)  ratpoison -c only -c "vsplit 1/2" ;;
  67)  ratpoison -c only -c "vsplit 2/3" ;;
  100) ratpoison -c only ;;
esac
echo $next > "$state"
ratpoison -c "echo width $next%"
