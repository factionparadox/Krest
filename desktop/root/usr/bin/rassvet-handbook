#!/bin/sh
# The CRUX handbook, offline (it came with the install stick), beside the Rassvet wiki.
#   rassvet-handbook        the handbook in less (/ searches, q quits)
#   rassvet-handbook mc     Midnight Commander: the handbook and the Rassvet wiki side by side
book=/usr/share/doc/crux/handbook.txt
case "${1:-read}" in
	read) exec rassvet-term "CRUX handbook" less "$book" ;;
	mc)   exec rassvet-term "Handbook" mc /usr/share/rassvet/learn/wiki /usr/share/doc/crux ;;
	*)    echo "usage: rassvet-handbook [read|mc]" >&2; exit 2 ;;
esac
