#!/bin/sh
# Super+Tab: the windows on this workstation and the nine workstations; pick one to go there.
pick=$({
  ratpoison -c "windows %n %c  %t" | sed 's/^/window /'
  for n in 1 2 3 4 5 6 7 8 9; do echo "workstation $n"; done
} | dmenu -i -l 20 -p "go to:" -fn 'DejaVu Sans Mono-12' -nb '#16161c' -sb '#c8323c') || exit 0
set -- $pick
case "$1" in
  window)      ratpoison -c "select $2" ;;
  workstation) ratpoison -c "gselect $2" ;;
esac
