#!/bin/sh
# krest-sleepcheck: does sleep reach the processor's deepest idle state (S0ix)?
# Suspends the laptop for 60 seconds (the RTC alarm wakes it), then compares Intel's counter of
# time spent in that state. Near 100 %: sleep is as frugal as the hardware allows. Near 0 %:
# something keeps the chip awake, and the battery drains overnight (krest-learn wiki framework).
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
secs=${1:-60}
lpit=/sys/devices/system/cpu/cpuidle/low_power_idle_system_residency_us
pmc=/sys/kernel/debug/pmc_core/slp_s0_residency_usec
counter() {
  if [ -r "$lpit" ]; then cat "$lpit"; return; fi
  mountpoint -q /sys/kernel/debug || mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
  [ -r "$pmc" ] && cat "$pmc"
}
before=$(counter) || true
[ -n "$before" ] || { echo "No S0ix counter on this machine (neither $lpit nor $pmc)."; exit 2; }
echo "Sleep mode: $(cat /sys/power/mem_sleep)   (s2idle in brackets is normal for this laptop)"
echo "Suspending for $secs seconds: the laptop wakes up by itself. Do not close the lid."
sync
rtcwake -m mem -s "$secs" >/dev/null || { echo "rtcwake could not suspend"; exit 1; }
after=$(counter)
used=$(( after - before ))
pct=$(( used / (secs * 10000) ))
echo "Time in S0ix: $(( used / 1000000 )) s of $secs s  (about $pct %)"
if [ "$pct" -ge 80 ]; then
  echo "Good: sleep is reaching the deepest state."
elif [ "$pct" -ge 1 ]; then
  echo "Partly: it reaches the deep state only some of the time. Try again with nothing plugged in."
else
  echo "It never reached the deep state: a device or driver keeps it awake. Look at:"
  echo "  sudo dmesg | grep -i -e 'PM:' -e s0ix -e suspend | tail -n 30"
  echo "  sudo cat /sys/kernel/debug/pmc_core/substate_requirements   (what was not ready)"
  echo "and unplug expansion cards one at a time to find the culprit."
fi
