#!/bin/sh
# Pustota's menu (Ctrl+Super+Space): dmenu lists, one per topic, like the classic right-click menu.
#   pustota-menu [main|russian|learn|power|system]
# Each entry is "label<TAB>command"; edit /usr/bin/pustota-menu's lists, or copy it to
# ~/.local/bin/pustota-menu and change your copy.
dm() { dmenu -i -l 14 -p "$1" -fn 'DejaVu Sans Mono-12' -nb '#16161c' -nf '#d8d8d8' -sb '#c8323c' -sf '#ffffff'; }
pick() {  # pick PROMPT, entries on stdin
  entries=$(cat)
  label=$(printf '%s\n' "$entries" | cut -f1 | dm "$1") || exit 0
  printf '%s\n' "$entries" | awk -F'\t' -v l="$label" '$1 == l { print $2; exit }'
}
run() { [ -n "$1" ] && setsid -f sh -c "$1" >/dev/null 2>&1; }

case "${1:-main}" in
main)
  run "$(pick 'Пустота' <<'M'
Terminal	pustota-term
Files (Midnight Commander)	pustota-term Files mc
Write (acme)	pustota-acme
Web	firefox
Office (LibreOffice)	libreoffice
Russian ›	pustota-menu russian
Learn the system ›	pustota-menu learn
Wi-Fi	networkmanager_dmenu
Bluetooth	pustota-term Bluetooth bluetuith
Sound	pustota-term Sound pulsemixer
System ›	pustota-menu system
Screenshot	pustota-screenshot
Keys	pustota-keys
Power ›	pustota-menu power
M
)" ;;
russian)
  run "$(pick 'Русский' <<'M'
Where to start (the route to B2)	pustota-term Russian pustota-russian --pause path
Words (10 minutes, spaced repetition)	pustota-term Слова pustota-russian --pause words
Tutor (AI, on this laptop)	pustota-term Репетитор pustota-russian --pause tutor
Listen (audiobooks)	pustota-term Listen pustota-russian --pause listen --pick
Course library (FSI, DLI, Peace Corps)	pustota-russian library --open
Textbook: Между нами	pustota-russian read mezhdunami
Dictionary (Wiktionary)	pustota-russian read wiktionary
Download material…	pustota-term Downloads sh -c 'sudo pustota-content; read -r -p "Enter to close " _'
M
)" ;;
learn)
  run "$(pick 'Learn' <<'M'
Lessons	pustota-term Learn pustota-learn browse
Wiki: Void explained (runit, XBPS ...)	pustota-term Wiki pustota-learn wiki
Wiki page…	pustota-menu wikipage
Search the lessons and the wiki…	pustota-menu search
System map (what is running)	pustota-term 'System map' sh -c 'pustota-learn doctor; read -r -p "Enter to close " _'
Explain a command…	pustota-menu explain
Void Handbook (in mc, beside the wiki)	pustota-handbook
Void Handbook (PDF book)	pustota-handbook pdf
Void Handbook (web pages, offline)	pustota-handbook web
Manual page…	pustota-menu manual
Where things come from	pustota-term Sources sh -c 'pustota-learn sources | less'
M
)" ;;
explain)
  cmd=$(printf '' | dm 'Explain (nothing is run):') || exit 0
  [ -n "$cmd" ] && setsid -f pustota-term Explain sh -c 'pustota-learn explain "$1" | less' _ "$cmd" ;;
wikipage)
  page=$(ls /usr/share/pustota/learn/wiki | sed 's/\.md$//' | dm 'Wiki page:') || exit 0
  [ -n "$page" ] && setsid -f pustota-term "Wiki: $page" pustota-learn wiki "$page" ;;
search)
  words=$(printf '' | dm 'Search the lessons and the wiki:') || exit 0
  [ -n "$words" ] && setsid -f pustota-term "Search: $words" sh -c 'pustota-learn search $1 | less' _ "$words" ;;
manual)
  page=$(printf '' | dm 'man') || exit 0
  [ -n "$page" ] && setsid -f pustota-term "man $page" man "$page" ;;
system)
  run "$(pick 'System' <<'M'
Update everything (xbps-install -Su)	pustota-term Update sh -c 'sudo xbps-install -Su; read -r -p "Enter to close " _'
Services (sv status)	pustota-term Services sh -c 'sudo sv status /var/service/* | less'
Processes (htop)	pustota-term htop htop
Battery report (powertop)	pustota-term powertop sudo powertop
Disks	pustota-term Disks sh -c 'lsblk -f; df -h -x tmpfs -x devtmpfs; read -r -p "Enter to close " _'
Night light on/off	pustota-nightlight toggle
Fingerprint: add a finger (for sudo)	pustota-term Fingerprint sh -c 'fprintd-enroll; read -r -p "Enter to close " _'
Firewall status (ufw)	pustota-term Firewall sh -c 'sudo ufw status verbose; read -r -p "Enter to close " _'
Firmware updates (fwupd)	pustota-term Firmware sh -c 'fwupdmgr refresh; fwupdmgr get-updates; read -r -p "Enter to close " _'
M
)" ;;
power)
  run "$(pick 'Power' <<'M'
Lock	loginctl lock-session
Suspend	loginctl suspend
Hibernate	loginctl hibernate
Log out	ratpoison -c quit
Restart	loginctl reboot
Power off	loginctl poweroff
M
)" ;;
*) echo "usage: pustota-menu [main|russian|learn|system|power]" >&2; exit 2 ;;
esac
