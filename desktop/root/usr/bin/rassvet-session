#!/bin/sh
# Rassvet's X session. ly starts it (/usr/share/xsessions/rassvet.desktop), or startx from
# ~/.xinitrc; each line starts one piece of the
# desktop, and ratpoison, the window manager, comes last: the session ends when it exits.

# A D-Bus session bus for notifications, mounting and the browser.
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && exec dbus-run-session -- "$0" "$@"

# programs D-Bus starts on request need the display
dbus-update-activation-environment DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP 2>/dev/null
# sound: PipeWire, its session manager and its PulseAudio side (no systemd user services here,
# so the session starts them; they stop when it ends)
pipewire & sleep 0.3
wireplumber &
pipewire-pulse &
xrdb -merge /etc/rassvet/Xresources                # fonts, DPI, terminal colours
[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"
xsetroot -cursor_name left_ptr
feh --no-fehbg --bg-fill /usr/share/rassvet/rassvet-wallpaper.png   # the Рассвет roundel
xset s 600 600 dpms 600 900 1200                   # blank after 10 minutes, screen off later
xss-lock --transfer-sleep-lock -- slock &          # lock on sleep, lid and Super+x
dunst &                                            # notifications
udiskie --automount --notify &                     # USB sticks and drives
xbanish &                                          # hide the pointer while typing
rassvet-battery &                                  # low-battery warnings, hibernate when empty
clipmenud &                                        # clipboard history (Super+v)
# the Secret Service, where the Proton VPN app keeps its login (and other apps their passwords)
command -v gnome-keyring-daemon >/dev/null && gnome-keyring-daemon --start --components=secrets >/dev/null
rassvet-nightlight &                               # warmer screen after sunset (redshift)
polybar rassvet >/dev/null 2>&1 &                  # the bar at the top
[ -x "$HOME/.config/rassvet/autostart" ] && "$HOME/.config/rassvet/autostart" &

exec ratpoison
