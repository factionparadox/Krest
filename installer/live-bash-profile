# Pustota live image: tty1 logs in automatically and starts the installer.
# Other consoles (Alt+F2 ... F6) give an ordinary shell: user anon, password voidlinux.
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
if [ "$(tty 2>/dev/null)" = /dev/tty1 ] && [ -z "${PUSTOTA_INSTALLER_STARTED:-}" ] &&
   [ -x /usr/bin/pustota-installer ]; then
    export PUSTOTA_INSTALLER_STARTED=1
    if [ -s /usr/lib/pustota/void-repo/x86_64-repodata ]; then
        # the offline ISO: everything is on the stick, no network needed
        sudo -n /usr/bin/pustota-installer
    else
        # Wi-Fi first: the installer needs Void's package repository before it touches a disk.
        sudo -n /usr/lib/pustota/live-network-setup.sh
    fi
fi
