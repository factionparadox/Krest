# The Krest installer starts on the first console; the other consoles (Alt+F2 ...) are
# ordinary root shells for looking around.
if [ "$(tty)" = /dev/tty1 ] && [ ! -e /tmp/.krest-install-started ]; then
	touch /tmp/.krest-install-started
	/usr/bin/krest-install
	echo
	echo "The installer has finished. This is a root shell; 'krest-install' starts it again."
fi
