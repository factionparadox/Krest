#!/usr/bin/env python3
"""rassvet-content: download the large Russian learning material, checking every file.

The AI tutor: the model (a GGUF file) comes from Hugging Face, checked against the SHA-256
Hugging Face publishes; llama.cpp's server runs it (the rassvet-tutor service, started here and
at every boot once the model is on disk). Kiwix ZIMs are checked against Kiwix's
published SHA-256; audiobooks against the Internet Archive's MD5 and SHA-1; course
files and voices against hashes pinned on their first download. Openly licensed packs
come first from the content mirror (GitHub release assets), so they cannot vanish.

    rassvet-content                          choose interactively
    rassvet-content list                     what is available and what is installed
    sudo rassvet-content refresh             re-read what is on disk (after copying packs in)
    sudo rassvet-content install PACK [PACK...]   (or: install all)
    sudo rassvet-content remove PACK
"""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(os.environ.get('RASSVET_CONTENT_ROOT', '/'))
PREFIX = Path(__file__).resolve().parent.parent      # the package: bin/, lib/, share/
LIB = Path(os.environ.get('RASSVET_CONTENT_LIB', PREFIX / 'lib/rassvet/content'))
SHARE = Path(os.environ.get('RASSVET_CONTENT_SHARE', PREFIX / 'share/rassvet/russian'))
DATA = ROOT / 'var/lib/rassvet/russian'
DATA_PATH = '/var/lib/rassvet/russian'          # as the running system sees it
CONFIG = DATA / 'russian.json'
KIWIX = os.environ.get('RASSVET_CONTENT_KIWIX', 'https://download.kiwix.org/zim')
ARCHIVE = os.environ.get('RASSVET_CONTENT_ARCHIVE', 'https://archive.org/')
MEZHDUNAMI = os.environ.get('RASSVET_CONTENT_MEZHDUNAMI', 'https://mezhdunami.org/')
HF = os.environ.get('RASSVET_CONTENT_HF', 'https://huggingface.co')
HERD = os.environ.get('RASSVET_CONTENT_HERD', 'herd')
YTDLP = os.environ.get('RASSVET_CONTENT_YTDLP', 'yt-dlp')
MIRROR_BASE = os.environ.get('RASSVET_CONTENT_MIRROR', '')   # tests only

ZIMS = {   # key: (Kiwix directory, file prefix)
    'wiktionary': ('wiktionary', 'wiktionary_en_all_nopic_'),
    'wiktionary-ru': ('wiktionary', 'wiktionary_ru_all_nopic_'),
    'wikisource': ('wikisource', 'wikisource_ru_all_nopic_'),
    'wikipedia': ('wikipedia', 'wikipedia_ru_all_mini_'),
}
PACKS = {
    'ru-voices': ('Russian voices for speech: Irina, Denis, Dmitri, Ruslan (Piper)', 0.25),
    'ai-tutor': ('AI Russian tutor: Qwen3.6 35B-A3B (3B active per word), on this laptop', 22.4),
    'ru-course': ('Courses: Между нами textbook with audio; FSI, DLI and Peace Corps books and audio', 1.2),
    'ru-dictionaries': ('Dictionaries: English and Russian Wiktionary (Kiwix)', 9.0),
    'ru-reading': ('Reading: Russian Wikisource (classics) and Wikipedia (introductions)', 6.0),
    'ru-audiobooks': ('Audiobooks: 29 LibriVox Russian recordings, A2 to B2', 5.0),
}
MODELS = {'ai-tutor': ('unsloth/Qwen3.6-35B-A3B-GGUF', 'Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf')}
TUTOR = DATA / 'tutor'                 # the GGUF, and tutor.gguf: the one the service runs
VOICES = ('irina', 'denis', 'dmitri', 'ruslan')


def say(text: str) -> None:
    print(text, flush=True)


def run(cmd: list[str]) -> bool:
    say('    $ ' + ' '.join(cmd[:3]) + (' …' if len(cmd) > 3 else ''))
    return subprocess.run(cmd).returncode == 0


def helper(name: str, *args: str) -> list[str]:
    return [sys.executable, '-I', str(LIB / name), *args]


def tutor_installed(pack: str) -> bool:
    link = TUTOR / 'tutor.gguf'
    return link.is_file() and os.readlink(link) == MODELS[pack][1]


def install_tutor(pack: str) -> bool:
    repo, name = MODELS[pack]
    if not run(helper('fetch-hf.py', '--repo', repo, '--file', name, '--dest', str(TUTOR), '--base', HF)):
        return False
    link = TUTOR / 'tutor.gguf'
    link.unlink(missing_ok=True)
    link.symlink_to(name)
    # the service runs as nobody: the model must be readable
    for path in (DATA, TUTOR, TUTOR / name):
        path.chmod(path.stat().st_mode | 0o444 | (0o111 if path.is_dir() else 0))
    subprocess.run([HERD, 'restart', 'rassvet-tutor'], capture_output=True)
    if not run([HERD, 'start', 'rassvet-tutor']):
        say('    the tutor service did not start: sudo herd status rassvet-tutor ; '
            'less /var/log/rassvet-tutor.log')
        return False
    return True


def zim_file(key: str) -> Path | None:
    found = sorted((DATA / 'dictionary').glob(ZIMS[key][1] + '*.zim'))
    return found[-1] if found else None


def installed(pack: str) -> bool:
    if pack in MODELS:
        return tutor_installed(pack)
    if pack == 'ru-voices':
        return all((DATA / 'voices' / f'ru_RU-{v}-medium.onnx').is_file() for v in VOICES)
    if pack == 'ru-course':
        return (DATA / 'library/SHA256SUMS').is_file() and (DATA / 'mezhdunami/index.html').is_file()
    if pack == 'ru-dictionaries':
        return bool(zim_file('wiktionary') and zim_file('wiktionary-ru'))
    if pack == 'ru-reading':
        return bool(zim_file('wikisource') and zim_file('wikipedia'))
    if pack == 'ru-audiobooks':
        return (DATA / 'audiobooks/catalog.json').is_file()
    raise KeyError(pack)


def update_config() -> None:
    """Point russian.json (read by rassvet-russian) at whatever is now on disk."""
    try:
        config = json.loads(CONFIG.read_text(encoding='utf-8'))
    except (OSError, ValueError):
        config = {}
    kiwix = {key: f'{DATA_PATH}/dictionary/{path.name}' for key in ZIMS if (path := zim_file(key))}
    config.update({'voices': f'{DATA_PATH}/voices', 'library': f'{DATA_PATH}/library',
                   'audiobooks': f'{DATA_PATH}/audiobooks', 'mezhdunami': f'{DATA_PATH}/mezhdunami',
                   'kiwix': kiwix})
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(json.dumps(config, indent=2) + '\n', encoding='utf-8')


def from_mirror(pack: str, dest: Path) -> bool:
    """The content mirror (GitHub release), verified; False means use the original sources."""
    args = helper('fetch-mirror.py', '--mirror', str(LIB / 'mirror.json'), '--pack', pack, '--dest', str(dest))
    if MIRROR_BASE:
        args += ['--base', MIRROR_BASE]
    result = subprocess.run(args)
    if result.returncode == 1:
        say('    content mirror failed; trying the original sources')
    return result.returncode == 0


def fetch_zims(keys: list[str]) -> bool:
    ok = True
    for key in keys:
        directory, prefix = ZIMS[key]
        say(f'  {prefix}*.zim')
        ok &= run(helper('fetch-kiwix.py', '--index', f'{KIWIX}/{directory}/', '--prefix', prefix,
                         '--dest', str(DATA / 'dictionary')))
    return ok


def install(pack: str) -> bool:
    say(f'\n==> {PACKS[pack][0]} (about {PACKS[pack][1]:g} GB)')
    DATA.mkdir(parents=True, exist_ok=True)
    locks = DATA / '.locks'
    locks.mkdir(exist_ok=True)
    if pack in MODELS:
        ok = install_tutor(pack)
    elif pack == 'ru-voices':
        ok = from_mirror(pack, DATA / 'voices') or run(
            helper('fetch-files.py', '--manifest', str(SHARE / 'voices.tsv'), '--dest', str(DATA / 'voices'),
                   '--lock', str(locks / 'voices.lock.json')))
    elif pack == 'ru-course':
        ok = from_mirror(pack, DATA / 'library') or run(
            helper('fetch-files.py', '--manifest', str(SHARE / 'library.tsv'), '--dest', str(DATA / 'library'),
                   '--lock', str(locks / 'library.lock.json')))
        if not (DATA / 'mezhdunami/index.html').is_file():
            # CC BY-NC-ND: a personal copy, made on this computer, never mirrored.
            ytdlp = shutil.which(YTDLP) or ''
            textbook = helper('fetch-mezhdunami.py', '--base', MEZHDUNAMI, '--dest', str(DATA / 'mezhdunami'))
            ok = run(textbook + (['--ytdlp', ytdlp] if ytdlp else [])) and ok
    elif pack == 'ru-dictionaries':
        ok = fetch_zims(['wiktionary', 'wiktionary-ru'])
    elif pack == 'ru-reading':
        ok = fetch_zims(['wikisource', 'wikipedia'])
    elif pack == 'ru-audiobooks':
        ok = from_mirror(pack, DATA / 'audiobooks') or run(
            helper('fetch-archive.py', '--manifest', str(SHARE / 'audiobooks.tsv'), '--dest', str(DATA / 'audiobooks'),
                   '--base', ARCHIVE))
    else:
        raise KeyError(pack)
    if pack.startswith('ru-'):
        update_config()
    say(f'    {"done" if ok else "FAILED (run it again to resume; finished files are kept)"}: {pack}')
    return ok


def remove(pack: str) -> bool:
    if pack in MODELS:
        # the service stops, and stays off after a restart (it starts only with a model)
        subprocess.run([HERD, 'stop', 'rassvet-tutor'], capture_output=True)
        for path in TUTOR.glob('*'):
            path.unlink()
        return True
    targets = {'ru-voices': [DATA / 'voices'],
               'ru-course': [DATA / 'library', DATA / 'mezhdunami'], 'ru-audiobooks': [DATA / 'audiobooks'],
               'ru-dictionaries': [zim_file('wiktionary'), zim_file('wiktionary-ru')],
               'ru-reading': [zim_file('wikisource'), zim_file('wikipedia')]}[pack]
    for target in filter(None, targets):
        if target.is_dir():
            shutil.rmtree(target)
        elif target.exists():
            target.unlink()
    update_config()
    say(f'removed {pack}')
    return True


def listing() -> None:
    say('Rassvet content: optional downloads (sizes approximate)\n')
    for n, (pack, (title, size)) in enumerate(PACKS.items(), 1):
        mark = 'installed' if installed(pack) else f'{size:>4g} GB'
        say(f'  {n}. {pack:16} {mark:>10}  {title}')
    free = shutil.disk_usage(ROOT if ROOT.exists() else '/').free / 1e9
    say(f'\nFree space: {free:.0f} GB')


def need_root() -> None:
    if os.geteuid() != 0 and not os.environ.get('RASSVET_CONTENT_ROOT'):
        sys.exit('rassvet-content: installing and removing need administrator rights: run it with sudo')


def choose(ask=input) -> list[str]:
    listing()
    say('\nType the numbers to download (e.g. 1 2 3), "all", or press Enter to quit.')
    reply = ask('> ').strip().lower()
    if not reply:
        return []
    names = list(PACKS)
    if reply == 'all':
        return [p for p in names if not installed(p)]
    picked = []
    for word in reply.replace(',', ' ').split():
        if word.isdigit() and 1 <= int(word) <= len(names):
            picked.append(names[int(word) - 1])
        elif word in PACKS:
            picked.append(word)
        else:
            say(f'ignored: {word}')
    return list(dict.fromkeys(picked))


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog='rassvet-content', description=__doc__.splitlines()[0])
    sub = ap.add_subparsers(dest='cmd')
    sub.add_parser('list')
    sub.add_parser('refresh')
    inst = sub.add_parser('install'); inst.add_argument('packs', nargs='+')
    rem = sub.add_parser('remove'); rem.add_argument('packs', nargs='+')
    args = ap.parse_args(argv)
    if args.cmd == 'list':
        listing(); return 0
    if args.cmd == 'refresh':
        need_root(); update_config(); say(f'updated {CONFIG}'); return 0
    if args.cmd is None:
        packs = choose()
        if not packs:
            return 0
        args.cmd = 'install'
    else:
        packs = args.packs
        if packs == ['all']:
            packs = [p for p in PACKS if not installed(p)]
        unknown = [p for p in packs if p not in PACKS]
        if unknown:
            say(f'unknown: {", ".join(unknown)} (choose from {", ".join(PACKS)})'); return 2
    need_root()
    if args.cmd == 'remove':
        return 0 if all([remove(p) for p in packs]) else 1
    needed = sum(PACKS[p][1] for p in packs if not installed(p))
    free = float(os.environ.get('RASSVET_CONTENT_FREE_GB') or shutil.disk_usage(ROOT).free / 1e9)  # tests
    if needed > free - 2:
        say(f'Not enough space: these need about {needed:g} GB and {free:.0f} GB is free.'); return 1
    results = [install(p) for p in packs]
    say('\nAll done.' if all(results) else '\nSome downloads failed; run the same command again to resume.')
    return 0 if all(results) else 1


if __name__ == '__main__':
    sys.exit(main())
