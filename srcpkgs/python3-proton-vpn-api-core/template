# Template file for 'python3-proton-vpn-api-core'
# Pustota: adopted from ProtonVPN-Void (https://codeberg.org/Alderson/ProtonVPN-Void, commit
# d4d093dd57df41f8a3f72f8c89c8417d8b23c21f), read and pinned: the Proton VPN app without systemd.
# Recipe copyright (c) 2026 Tommy Alderson, MIT licence (ProtonVPN-Void/LICENSE).
pkgname=python3-proton-vpn-api-core
version=5.8.3
revision=1
build_style=python3-module
make_check=no
build_helper="rust"

hostmakedepends="
 cargo
 rust
 cmake
 python3-setuptools
 python3-devel
"

depends="
 python3-proton-core>=0.7.4_1
 python3-distro
 python3-sentry-sdk
 python3-cryptography
 python3-pynacl
 python3-fido2
 python3-packaging
 python3-dbus-fast
 python3-gobject
 python3-cairo
 python3-Jinja2
 NetworkManager
 NetworkManager-openvpn
"

short_desc="Proton VPN Core API"
maintainer="Pustota <pustota@localhost>"
license="GPL-3.0-only"
homepage="https://github.com/ProtonVPN/python-proton-vpn-api-core"

# ProTun, Proton's NetworkManager VPN plugin, built in from its tagged release. The kill switch
# (Rust feature kill_switch) is left out: its permanent mode is a systemd boot unit.
_protun_version=2.2.1

distfiles="
 https://github.com/ProtonVPN/python-proton-vpn-api-core/archive/refs/tags/v${version}.tar.gz
 https://github.com/ProtonVPN/protun/archive/refs/tags/v${_protun_version}.tar.gz
"
checksum="
 13412fa7d540ba861d904b4a208e5c51c489330edab512fcaa766536a7a97709
 4bf7eab3255332ffd97e1906a79d048fddb0d1bc40b6caefb899de9106e322cc
"

wrksrc="python-proton-vpn-api-core-${version}"
skip_extraction="v${_protun_version}.tar.gz"

post_extract() {
    rm -rf dependencies/protun
    mkdir -p dependencies/protun
    vsrcextract -C dependencies/protun "v${_protun_version}.tar.gz"
}

pre_build() {
    cargo build         --release         --locked         --no-default-features         --features "python,core,local_agent,protun,telemetry"         --bin nm-protun-service         --lib

    install -Dm755         target/release/libproton_vpn_platform.so         proton/vpn/platform.abi3.so
}

post_install() {
    vinstall target/release/nm-protun-service         755 usr/libexec

    vmkdir usr/lib/NetworkManager/VPN

    sed         -e 's|^program=.*|program=/usr/libexec/nm-protun-service|'         -e '/^SystemdService=/d'         resources/nm-protun.name         > "${XBPS_BUILDDIR}/nm-protun.name"

    vinstall "${XBPS_BUILDDIR}/nm-protun.name"         644 usr/lib/NetworkManager/VPN

    vinstall resources/nm-protun-service.conf         644 usr/share/dbus-1/system.d
}
