# Template file for 'ly'
# Pustota: ly, a login manager that is a text box on the console: no X server or toolkit of its
# own, nothing to wait for. Not in Void at Pustota's pin. Release 1.4.1 needs Zig 0.16 and Void
# has 0.13, so the build uses Zig's own 0.16.0 release (checked against the SHA-256 that
# ziglang.org publishes). Everything is fetched in do_fetch, including ly's one Zig dependency
# (zig-clap, pinned by hash in build.zig.zon), so the build itself needs no network.
pkgname=ly
version=1.4.1
revision=1
archs="x86_64"
_commit=afb1dc62a0568743c9a7952623ec179128c73340
_zig=0.16.0
_zig_sha256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
hostmakedepends="git pkg-config ca-certificates"
makedepends="pam-devel libxcb-devel"
depends="xauth xorg-server util-linux ncurses brightnessctl"
short_desc="Console login manager: a text box on tty1"
maintainer="Pustota <pustota@localhost>"
license="WTFPL"
homepage="https://github.com/fairyglade/ly"
conf_files="/etc/ly/config.ini /etc/pam.d/ly /etc/pam.d/ly-autologin"
nopie=yes

_zigenv() {
	export ZIG_GLOBAL_CACHE_DIR="${wrksrc}/.zig-global" ZIG_LOCAL_CACHE_DIR="${wrksrc}/.zig-cache"
}

do_fetch() {
	git clone -q https://github.com/fairyglade/ly.git "${wrksrc}"
	git -C "${wrksrc}" checkout -q --detach "${_commit}"
	[ "$(git -C "${wrksrc}" rev-parse HEAD)" = "${_commit}" ] || msg_error "ly is not at ${_commit}\n"
	local tarball="${wrksrc}/.zig-${_zig}.tar.xz"
	xbps-fetch -o "${tarball}" "https://ziglang.org/download/${_zig}/zig-x86_64-linux-${_zig}.tar.xz"
	echo "${_zig_sha256}  ${tarball}" | sha256sum -c - || msg_error "zig ${_zig}: wrong SHA-256\n"
	mkdir -p "${wrksrc}/.zig"
	tar -xf "${tarball}" -C "${wrksrc}/.zig" --strip-components=1
	rm -f "${tarball}"
	_zigenv
	cd "${wrksrc}" && ./.zig/zig build --fetch
}

do_build() {
	_zigenv
	./.zig/zig build -Doptimize=ReleaseSafe -Dcpu=baseline -Dinit_system=runit -Ddefault_tty=1
}

do_install() {
	_zigenv
	./.zig/zig build installexe -Doptimize=ReleaseSafe -Dcpu=baseline -Dinit_system=runit \
		-Ddefault_tty=1 -Ddest_directory="${DESTDIR}"
	# ly's own runit service reads a variable that is never set (so tty1 gets cleared); Pustota's
	# is the same three files, written plainly
	rm -rf "${DESTDIR}/etc/sv/ly"
	vsv ly
	vlicense license.md

	# Pustota's look: black, white and red, a title, a clock; no animation
	local conf="${DESTDIR}/etc/ly/config.ini" kv key
	for kv in \
		"animation = none" \
		"bg = 0x00000000" \
		"fg = 0x00FFFFFF" \
		"border_fg = 0x00CC0000" \
		"error_fg = 0x01FF3333" \
		"box_title = ПУСТОТА" \
		"clock = %a %d %b  %H:%M" \
		"hide_version_string = true" \
		"xinitrc = null" \
		"shutdown_cmd = /usr/bin/shutdown -h now" \
		"restart_cmd = /usr/bin/shutdown -r now"; do
		key=${kv%% =*}
		grep -q "^${key} = " "${conf}" || msg_error "ly config.ini has no '${key}'\n"
		sed -i "s|^${key} = .*|${kv}|" "${conf}"
	done
	vinstall "${FILESDIR}/pustota.desktop" 644 usr/share/xsessions
}
