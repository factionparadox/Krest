# Template file for 'intel-lpmd'
# Pustota: Intel's Energy Optimizer (lpmd), not packaged for Void. Release 0.1.0 is the one
# that adds Panther Lake (newer upstream code is marked "test release, do not include in any
# distro release"). Built against elogind, which provides libsystemd.pc and sd-bus; run as a
# runit service in cgroup v2 "isolate" mode, which writes /sys/fs/cgroup itself and needs no
# systemd. files/intel_lpmd_config_F6_M204.xml is Pustota's Panther Lake configuration.
pkgname=intel-lpmd
version=0.1.0
revision=1
_commit=956df747e56aca1739b39bff8cff77e81758af9a
build_style=gnu-configure
configure_args="--with-systemdsystemunitdir=no --disable-werror
 --with-dbus-sys-dir=/usr/share/dbus-1/system.d"
hostmakedepends="automake libtool pkg-config gtk-doc autoconf-archive glib-devel git"
makedepends="glib-devel libxml2-devel libnl3-devel elogind-devel upower-devel"
depends="upower dbus"
short_desc="Intel Energy Optimizer: light work on the low-power cores"
maintainer="Pustota <pustota@localhost>"
license="GPL-2.0-or-later"
homepage="https://github.com/intel/intel-lpmd"
conf_files="/etc/intel_lpmd/*.xml"

# no release files to download: fetch the pinned commit with git, and check it
do_fetch() {
	git clone -q https://github.com/intel/intel-lpmd.git "${wrksrc}"
	git -C "${wrksrc}" checkout -q --detach "${_commit}"
	[ "$(git -C "${wrksrc}" rev-parse HEAD)" = "${_commit}" ] || msg_error "intel-lpmd is not at ${_commit}\n"
}

pre_configure() {
	NO_CONFIGURE=1 ./autogen.sh
}

post_install() {
	# its install step also leaves a gzipped copy of one manual page; Void ships them plain
	rm -f "${DESTDIR}"/usr/share/man/man8/*.gz
	# keep Intel's own Panther Lake file for reference; Pustota's replaces it
	mv "${DESTDIR}/etc/intel_lpmd/intel_lpmd_config_F6_M204.xml" \
		"${DESTDIR}/etc/intel_lpmd/intel_lpmd_config_F6_M204.xml.intel"
	vinstall "${FILESDIR}/intel_lpmd_config_F6_M204.xml" 644 etc/intel_lpmd
	vsv intel_lpmd
}
