# Krest's changes to Arch Linux's kernel configuration (base.config, for the same kernel
# series): a smaller, faster build for one laptop. Everything Arch enables for laptops stays.
CONFIG_LOCALVERSION="-krest"
# no debug information (hours less to build, no pahole needed) and no Rust drivers
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_RUST is not set
# modules are not signed: they are built and installed together, on this laptop
# CONFIG_MODULE_SIG is not set
# the disk and its filesystem built in, so the system boots even without the initramfs
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_VMD=y
CONFIG_XFS_FS=y
CONFIG_VFAT_FS=y
# SELinux is unused here
# CONFIG_SECURITY_SELINUX is not set
CONFIG_LSM="landlock,lockdown,yama,integrity"
