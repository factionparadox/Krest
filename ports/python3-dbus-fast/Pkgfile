# Description: Fast D-Bus library for Python asyncio (for the Proton VPN app)
# URL: https://pypi.org/project/dbus_fast/
# Maintainer: Krest
# Depends on: python3-build python3-cython python3-installer python3-poetry-core python3-setuptools

name=python3-dbus-fast
version=5.2.0
release=1
source=(https://files.pythonhosted.org/packages/source/d/dbus-fast/dbus_fast-$version.tar.gz)

build() {
	cd dbus_fast-$version
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
