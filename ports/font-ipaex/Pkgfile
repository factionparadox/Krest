# Description: IPAex Japanese fonts (Gothic and Mincho), for reading Japanese
# URL: https://moji.or.jp/ipafont/
# Maintainer: Krest
# Depends on: fontconfig

name=font-ipaex
version=004.01
release=1
source=(https://moji.or.jp/wp-content/ipafont/IPAexfont/IPAexfont00401.zip)

build() {
	install -d $PKG/usr/share/fonts/TTF
	install -m644 IPAexfont00401/*.ttf $PKG/usr/share/fonts/TTF/
}
