# Description: The Go fonts (Go Mono is X-терминал's font)
# URL: https://go.dev/blog/go-fonts
# Maintainer: Rassvet
# Depends on: fontconfig

name=font-go
version=0.47.0
release=1
source=(https://github.com/golang/image/archive/v$version/image-$version.tar.gz)

build() {
	install -d $PKG/usr/share/fonts/TTF
	install -m644 image-$version/font/gofont/ttfs/*.ttf $PKG/usr/share/fonts/TTF/
}
