# Description: FIDO2 security keys, in Python (for the Proton VPN app)
# URL: https://pypi.org/project/fido2/
# Maintainer: Rassvet
# Depends on: python3-build python3-cryptography python3-installer python3-poetry-core

name=python3-fido2
version=2.2.1
release=1
source=(https://files.pythonhosted.org/packages/source/f/fido2/fido2-$version.tar.gz)

build() {
	cd fido2-$version
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
