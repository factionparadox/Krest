# Description: Simple window manager: every window fills the screen, all keyboard
# URL: https://www.nongnu.org/ratpoison/
# Maintainer: Rassvet
# Depends on: readline xorg-libxft xorg-libxinerama xorg-libxrandr xorg-libxtst

name=ratpoison
version=1.4.9
release=1
source=(https://download.savannah.gnu.org/releases/$name/$name-$version.tar.xz)

build() {
	cd $name-$version
	./configure --prefix=/usr --mandir=/usr/share/man --infodir=/usr/share/info \
		--disable-history-file-locking
	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share/info $PKG/usr/share/doc
}
