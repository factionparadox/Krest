# Description: ACPI events: the lid, the power button and the charger
# URL: https://sourceforge.net/projects/acpid2/
# Maintainer: Rassvet

name=acpid
version=2.0.34
release=1
source=(https://downloads.sourceforge.net/project/acpid2/$name-$version.tar.xz
	acpid.rc lid power)

build() {
	cd $name-$version
	./configure --prefix=/usr --sbindir=/usr/sbin --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/share/doc
	install -Dm755 $SRC/acpid.rc $PKG/etc/rc.d/acpid
	install -Dm644 $SRC/lid $PKG/etc/acpi/events/lid
	install -Dm644 $SRC/power $PKG/etc/acpi/events/power
}
