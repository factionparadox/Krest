#!/bin/sh
#
# /etc/rc.d/acpid: start/stop the ACPI event daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/acpid
PID=/run/acpid.pid

case $1 in
start)
	$SSD --start --pidfile $PID --exec $PROG -- -p $PID
	;;
stop)
	$SSD --stop --retry 10 --pidfile $PID --remove-pidfile
	;;
restart)
	$0 stop
	$0 start
	;;
status)
	$SSD --status --pidfile $PID
	case $? in
	0) echo "$PROG is running with pid $(cat $PID)" ;;
	*) echo "$PROG is not running" ;;
	esac
	;;
*)
	echo "usage: $0 [start|stop|restart|status]"
	;;
esac

# End of file
