# Description: Krest's desktop: the ratpoison session, menus, keys, bar, scripts and settings
# URL: https://github.com/factionparadox/Krest
# Maintainer: Krest
# Depends on: brightnessctl curl dmenu dunst feh fontconfig libnotify maim nftables polybar ratpoison redshift slock sudo x-terminal xbanish xclip xorg-xrdb xorg-xset xorg-xsetroot xss-lock clipmenu python3

name=krest-desktop
version=@VERSION@
release=@RELEASE@
# made from this repository's desktop/root by build/krest-ports
source=(krest-desktop-$version.tar.gz)

build() {
	cp -a root/. $PKG/
	sed -i "s/@VERSION@/$version/" $PKG/etc/xdg/fastfetch/config.jsonc.in
	mv $PKG/etc/xdg/fastfetch/config.jsonc.in $PKG/etc/xdg/fastfetch/config.jsonc
	chmod 440 $PKG/etc/sudoers.d/krest
}
