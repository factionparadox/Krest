# Description: rassvet-learn: lessons and a wiki on how this system works, in the terminal
# URL: https://github.com/factionparadox/Pustota
# Maintainer: Rassvet
# Depends on: python3

name=rassvet-learn
version=@VERSION@
release=@RELEASE@
source=(rassvet-learn-$version.tar.gz)

build() {
	install -Dm755 learn/rassvet-learn $PKG/usr/bin/rassvet-learn
	install -d $PKG/usr/share/rassvet/learn
	cp -a learn/topics learn/wiki $PKG/usr/share/rassvet/learn/
}
