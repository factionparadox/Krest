# Description: Proton's keyring plugins for Linux (for the Proton VPN app)
# URL: https://github.com/ProtonVPN/python-proton-keyring-linux
# Maintainer: Rassvet
# Depends on: python3-build python3-installer python3-keyring python3-proton-core python3-setuptools

name=python3-proton-keyring-linux
version=0.2.3
release=1
source=(https://github.com/ProtonVPN/python-proton-keyring-linux/archive/v$version/python-proton-keyring-linux-$version.tar.gz)

build() {
	cd python-proton-keyring-linux-$version
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
