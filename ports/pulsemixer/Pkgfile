# Description: Sound mixer in the terminal (Ctrl+Super+m)
# URL: https://pypi.org/project/pulsemixer/
# Maintainer: Rassvet
# Depends on: pulseaudio python3-build python3-installer python3-setuptools

name=pulsemixer
version=1.5.1
release=1
source=(https://files.pythonhosted.org/packages/source/p/pulsemixer/pulsemixer-$version.tar.gz)

build() {
	cd pulsemixer-$version
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
}
