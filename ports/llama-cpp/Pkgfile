# Description: Runs language models on the CPU (the Russian tutor's server)
# URL: https://github.com/ggml-org/llama.cpp
# Maintainer: Krest

name=llama-cpp
version=0.8.0
_ui=11960
release=1
source=(https://github.com/ggml-org/llama.cpp/archive/v$version/llama.cpp-$version.tar.gz
	https://github.com/ggml-org/llama.cpp/releases/download/b$_ui/llama-b$_ui-ui.tar.gz)

build() {
	# the server's web pages: llama.cpp publishes them built, beside the release
	mv llama-b$_ui llama.cpp-$version/tools/ui/dist
	cmake -S llama.cpp-$version -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release \
		-DGGML_NATIVE=ON -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF \
		-DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=ON
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
