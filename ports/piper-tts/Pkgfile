# Description: Piper: neural Russian voices for krest-russian say (Irina, Denis, Dmitri, Ruslan)
# URL: https://github.com/rhasspy/piper
# Maintainer: Krest

name=piper-tts
version=2023.11.14.2
release=1
# Piper's own Linux build, with its onnxruntime and espeak-ng
source=(https://github.com/rhasspy/piper/releases/download/2023.11.14-2/piper_linux_x86_64.tar.gz)
PKGMK_NO_STRIP="yes"

build() {
	install -d $PKG/usr/lib/krest
	cp -a piper $PKG/usr/lib/krest/piper
}
