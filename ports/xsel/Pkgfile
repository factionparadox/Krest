# Description: Command-line access to the X selections (used by clipmenu)
# URL: https://github.com/kfish/xsel
# Maintainer: Krest
# Depends on: xorg-libxt

name=xsel
version=1.2.1
release=1
source=(https://github.com/kfish/$name/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	./autogen.sh || autoreconf -fi
	./configure --prefix=/usr --mandir=/usr/share/man
	make
	make DESTDIR=$PKG install
}
