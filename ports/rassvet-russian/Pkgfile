# Description: Constellation's Russian kit, A1 to B2: words, courses, audiobooks, voices, the AI tutor
# URL: https://github.com/factionparadox/Pustota
# Maintainer: Rassvet
# Depends on: kiwix-tools llama-cpp mpv piper-tts python3 yt-dlp

name=rassvet-russian
version=@VERSION@
release=@RELEASE@
source=(rassvet-russian-$version.tar.gz)

build() {
	cd russian
	install -Dm755 rassvet-russian $PKG/usr/bin/rassvet-russian
	install -Dm755 rassvet-content $PKG/usr/bin/rassvet-content
	install -d $PKG/usr/lib/rassvet/content $PKG/usr/share/rassvet/russian
	install -m644 fetch-*.py mirror.json $PKG/usr/lib/rassvet/content/
	install -m644 *.tsv VOCAB-SOURCES.md $PKG/usr/share/rassvet/russian/
	install -d -m755 $PKG/var/lib/rassvet/russian
}
