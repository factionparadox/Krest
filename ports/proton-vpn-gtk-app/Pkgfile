# Description: The Proton VPN app (Ctrl+Super+p)
# URL: https://github.com/ProtonVPN/proton-vpn-gtk-app
# Maintainer: Krest
# Depends on: gnome-keyring gtk4 libnotify librsvg python3-build python3-cairo python3-dbus python3-distro python3-gobject python3-installer python3-packaging python3-proton-core python3-proton-keyring-linux python3-proton-vpn-api-core python3-requests python3-setuptools

name=proton-vpn-gtk-app
version=4.18.5
release=1
source=(https://github.com/ProtonVPN/proton-vpn-gtk-app/archive/v$version/proton-vpn-gtk-app-$version.tar.gz)

build() {
	cd proton-vpn-gtk-app-$version
	/usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
	/usr/bin/python3 -m installer --compile-bytecode 2 --destdir=$PKG dist/*.whl
	install -Dm644 rpmbuild/SOURCES/proton.vpn.app.gtk.desktop $PKG/usr/share/applications/proton.vpn.app.gtk.desktop
	install -Dm644 rpmbuild/SOURCES/proton-vpn-logo.svg $PKG/usr/share/icons/hicolor/scalable/apps/proton-vpn-logo.svg
	# Krest's menus start it as protonvpn-app
	[ -e $PKG/usr/bin/protonvpn-app ] || ln -s protonvpn $PKG/usr/bin/protonvpn-app
}
