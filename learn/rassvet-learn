def doc_root():
    """The lessons and the wiki: $RASSVET_LEARN_ROOT, else beside this script (in the store:
    bin/../share/rassvet/learn; in a checkout of the repository: learn/ itself), else the
    system profile."""
    if os.environ.get("RASSVET_LEARN_ROOT"):
        return Path(os.environ["RASSVET_LEARN_ROOT"])
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "share/rassvet/learn", here):
        if (candidate / "topics").is_dir():
            return candidate
    return Path("/run/current-system/profile/share/rassvet/learn")


