def doc_root():
    """The lessons and the wiki: $KREST_LEARN_ROOT, else beside this script (installed:
    /usr/bin/../share/krest/learn; in a checkout of the repository: learn/ itself), else
    /usr/share/krest/learn."""
    if os.environ.get("KREST_LEARN_ROOT"):
        return Path(os.environ["KREST_LEARN_ROOT"])
    here = Path(__file__).resolve().parent
    for candidate in (here.parent / "share/krest/learn", here):
        if (candidate / "topics").is_dir():
            return candidate
    return Path("/usr/share/krest/learn")


