def topics():
    root = DOC_ROOT / "topics"
    if not root.is_dir():
        return {}
    return {p.stem: p for p in sorted(root.glob("*.md"))
            if p.is_file() and TOPIC_NAME.fullmatch(p.stem)}


def read_topic(name):
    if not TOPIC_NAME.fullmatch(name):
        return None
    path = topics().get(name)
    return path.read_text(encoding="utf-8") if path else None


def learn(name=None):
    if name is None:
        available = topics()
        if not available:
            print("Pustota offline lessons are missing.", file=sys.stderr)
            return 2
        print("PUSTOTA LEARN — understand, inspect, adapt\n")
        for key, path in available.items():
            heading = next((line[2:] for line in path.read_text(encoding="utf-8").splitlines()
                            if line.startswith("# ")), key)
            print(f"  {key:<16} {heading}")
        print("\nRead: pustota-learn learn packages")
        print("Browse: pustota-learn browse")
        print("The wiki (Void in depth): pustota-learn wiki ; search: pustota-learn search WORD")
        print("Explain without running: pustota-learn explain \"sv status dbus\"")
        return 0
    page = read_topic(name)
    if page is None:
        print("Unknown lesson. List lessons with pustota-learn learn.",
              file=sys.stderr)
        return 2
    print(page)
    return 0


def wiki_pages():
    root = DOC_ROOT / "wiki"
    if not root.is_dir():
        return {}
    return {p.stem: p for p in sorted(root.glob("*.md"))
            if p.is_file() and TOPIC_NAME.fullmatch(p.stem)}


def show(text):
    """Long pages go through less in a terminal; otherwise print them."""
    pager = shutil.which("less")
    if pager and sys.stdout.isatty() and text.count("\n") > 40:
        subprocess.run([pager, "-R"], input=text, text=True, check=False)
    else:
        print(text)


def wiki(name=None):
    pages = wiki_pages()
    if not pages:
        print("The Pustota wiki is missing (pustota-learn package).", file=sys.stderr)
        return 2
    if name is None:
        name = "index"
    name = WIKI_FOR.get(name, name)
    if not TOPIC_NAME.fullmatch(name) or name not in pages:
        print(f"No wiki page '{name}'. The index: pustota-learn wiki ; "
              f"search: pustota-learn search {name}", file=sys.stderr)
        return 2
    show(pages[name].read_text(encoding="utf-8"))
    return 0


def search(words):
    """Every line in the lessons and the wiki containing all the words (any case)."""
    words = [w.lower() for w in words if w.strip()]
    if not words:
        print("Usage: pustota-learn search WORD [WORD...]", file=sys.stderr)
        return 2
    found = 0
    for kind, pages in (("wiki", wiki_pages()), ("learn", topics())):
        for name, path in pages.items():
            for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                if all(w in line.lower() for w in words):
                    print(f"{kind} {name}:{number}: {line.strip()}")
                    found += 1
    if not found:
        print("Nothing found. The wiki's index: pustota-learn wiki")
        return 1
    print(f"\nRead a page: pustota-learn wiki NAME  (or: pustota-learn learn NAME)")
    return 0


def browse():
    while True:
        available = list(topics())
        if not available:
            return learn()
        print("\nPUSTOTA LEARN — offline lessons\n")
        for i, item in enumerate(available, 1):
            print(f"  {i:2}. {item}")
        print("   q. Quit")
        try:
            response = input("Choose a lesson: ").strip()
        except (EOFError, KeyboardInterrupt):
            return 0
        if response.lower() in ("", "q", "quit", "exit"):
            return 0
        if not response.isdigit() or int(response) not in range(1, len(available) + 1):
            print("Enter a listed number.")
            continue
        print("\n" + (read_topic(available[int(response) - 1]) or "Missing lesson"))
        try:
            input("\nEnter to return to the lessons...")
        except (EOFError, KeyboardInterrupt):
            return 0


def explain(parts):
    if not parts:
        print('Usage: pustota-learn explain "xbps-install -Syu"', file=sys.stderr)
        return 2
    command_line = " ".join(parts)
    try:
        tokens = shlex.split(command_line)
    except ValueError as error:
        print("Invalid command: " + str(error), file=sys.stderr)
        return 2
    if not tokens:
        return 2
    # sudo (run as root) and 9 (run the Plan 9 version) only wrap the real command
    while Path(tokens[0]).name in ("sudo", "9") and len(tokens) > 1:
        tokens = tokens[1:]
    command = Path(tokens[0]).name.lower()
    print("Command: " + command_line)
    print("READ ONLY: This command was NOT executed.\n")
    lesson_name = ALIASES.get(command)
    lesson = read_topic(lesson_name) if lesson_name else None
    print(lesson or "No dedicated lesson for this command. Read its manual page.")
    if command == "xbps-install" and any(flag in tokens for flag in ("-Syu", "-Su")):
        print("\nXBPS updates are rolling-release transactions; avoid partial upgrades.")
        print("XBPS itself may need updating in a separate first transaction.")
    if command in ("mkfs.xfs", "mkfs.vfat", "wipefs", "sgdisk", "grub-install", "xbps-remove",
                   "xfs_repair", "dd"):
        print("\nCAUTION: this command can change or destroy system state.")
    if command in WIKI_FOR:
        print("\nIn depth: pustota-learn wiki " + WIKI_FOR[command])
    print("Reference: " + MANUALS.get(command, "man " + command))
    return 0


def read_only(argv, timeout=4):
    if not shutil.which(argv[0]):
        return "unavailable: " + argv[0]
    try:
        result = subprocess.run(argv, capture_output=True, text=True,
                                check=False, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return "not available"
    if result.returncode != 0:
        return "unavailable or inactive"
    return result.stdout.strip().split("\n")[0][:190] or "no output"


def battery():
    for bat in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            return (f"{bat.name} {(bat / 'capacity').read_text().strip()} % "
                    f"{(bat / 'status').read_text().strip().lower()}")
        except OSError:
            continue
    return "no battery reported"


def doctor():
    print("PUSTOTA SYSTEM MAP: observations only; nothing is changed or sent anywhere.\n")
    values = (
        ("Kernel", ["uname", "-r"]),
        ("Root filesystem", ["findmnt", "-n", "-o", "SOURCE,FSTYPE,OPTIONS", "--target", "/"]),
        ("Swap", ["swapon", "--show=NAME,TYPE,SIZE", "--noheadings"]),
        ("Architecture", ["xbps-uhelper", "arch"]),
        ("Repositories", ["xbps-query", "-L"]),
        ("Pustota", ["xbps-query", "-p", "pkgver", "pustota-desktop"]),
        ("D-Bus", ["sv", "status", "dbus"]),
        ("elogind", ["sv", "status", "elogind"]),
        ("NetworkManager", ["sv", "status", "NetworkManager"]),
        ("Bluetooth", ["sv", "status", "bluetoothd"]),
        ("TLP (power)", ["sv", "status", "tlp"]),
        ("zram", ["zramctl", "--noheadings", "--output", "NAME,DISKSIZE,ALGORITHM"]),
    )
    for label, argv in values:
        print(f"{label:<17} {read_only(argv)}")
    print(f"{'Battery':<17} {battery()}")
    print(f"{'Display':<17} {os.environ.get('DISPLAY', 'not in X')}  (window manager: ratpoison)")
    print("\nWhat each line means: pustota-learn learn architecture")
    print("Sources and manuals:  pustota-learn sources")
    return 0


def open_reference(target):
    try:
        return 0 if webbrowser.open(target) else 2
    except (OSError, webbrowser.Error):
        return 2


def handbook():
    if HANDBOOK.is_file():
        if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
            if open_reference(HANDBOOK.as_uri()) == 0:
                return 0
        print("Offline Void Handbook: " + str(HANDBOOK))
        print("Read in a terminal: void-docs, or void-docs packages")
        return 0
    print("Offline handbook missing; install the void-docs package.")
    print("Online: " + HANDBOOK_WEB)
    return 2


def sources():
    print("PUSTOTA REFERENCE LIBRARY\n")
    for name, address in SOURCES:
        print(f"{name}\n  {address}")
    return 0


def manual(name):
    if not MAN_NAME.fullmatch(name):
        print("Invalid manual name.", file=sys.stderr)
        return 2
    if not shutil.which("man"):
        print("Manual viewer unavailable; read " + MANPAGES_WEB, file=sys.stderr)
        return 2
    return subprocess.run(["man", "--", name], check=False).returncode


def main(argv=None):
    p = argparse.ArgumentParser(prog="pustota-learn",
                                description="Read-only lessons and inspection for Pustota")
    sub = p.add_subparsers(dest="action")
    ln = sub.add_parser("learn", help="list or read an offline chapter")
    ln.add_argument("topic", nargs="?")
    ex = sub.add_parser("explain", help="explain without executing")
    ex.add_argument("command", nargs=argparse.REMAINDER)
    sub.add_parser("browse", help="browse offline chapters interactively")
    wk = sub.add_parser("wiki", help="the Pustota wiki: Void explained, page by page")
    wk.add_argument("page", nargs="?")
    se = sub.add_parser("search", help="search the lessons and the wiki")
    se.add_argument("words", nargs="+")
    sub.add_parser("doctor", help="show read-only system state")
    sub.add_parser("handbook", help="open locally installed Void Handbook")
    sub.add_parser("sources", help="show authoritative reference links")
    ma = sub.add_parser("manual", help="open installed man page")
    ma.add_argument("name")
    args = p.parse_args(argv)
    if args.action in (None, "learn"):
        return learn(getattr(args, "topic", None))
    if args.action == "browse":
        return browse()
    if args.action == "wiki":
        return wiki(args.page)
    if args.action == "search":
        return search(args.words)
    if args.action == "doctor":
        return doctor()
    if args.action == "explain":
        return explain(args.command)
    if args.action == "handbook":
        return handbook()
    if args.action == "sources":
        return sources()
    if args.action == "manual":
        return manual(args.name)
    return 2


if __name__ == "__main__":
    sys.exit(main())
